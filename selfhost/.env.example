# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# Contraseña de la base de datos. Genera una con:  openssl rand -hex 24
# (solo letras y números, así no hace falta escapar nada)
POSTGRES_PASSWORD=

# Puerto donde escucha el servidor en esta máquina.
TBD_PORT=8787

# Solo si usas HTTPS con dominio propio (perfil «https»), por ejemplo: tbd.midominio.com
TBD_DOMAIN=
