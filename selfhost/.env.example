# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# Atlas connection string for the server-side app. Create a database user in Atlas,
# then URL-encode special characters in its password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tbd

# Puerto donde escucha el servidor en esta máquina.
TBD_PORT=8787

# Solo si usas HTTPS con dominio propio (perfil «https»), por ejemplo: tbd.midominio.com
TBD_DOMAIN=
